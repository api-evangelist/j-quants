    {
      "info": {
        "name": "Refresh Token",
        "type": "http"
      },
      "http": {
        "method": "POST",
        "url": "https://api.jquants.com/v1/token/auth_user",
        "body": {
          "type": "json",
          "data": "{}"
        }
      },
      "docs": "Obtain a refresh token from the user's email and password."
    },
    {
      "info": {
        "name": "ID Token",
        "type": "http"
      },
      "http": {
        "method": "POST",
        "url": "https://api.jquants.com/v1/token/auth_refresh",
        "params": [
          {
            "name": "refreshtoken",
            "value": "",
            "type": "query"
          }
        ]
      },
      "docs": "Exchange a refresh token for an ID token."
    },
